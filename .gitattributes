# Baseline : normalize text files
* text=auto

# Unity - Code / Shaders (text + LF)
*.cs      text diff=csharp eol=lf
*.cginc   text eol=lf
*.shader  text eol=lf
*.compute text eol=lf
*.hlsl    text eol=lf

# Unity - Common text configs used in projects/packages (text + LF)
*.json    text eol=lf
*.xml     text eol=lf
*.md      text eol=lf
*.txt     text eol=lf

# Assembly definitions / New Input System
*.asmdef       text eol=lf
*.asmref       text eol=lf
*.inputactions text eol=lf

# UI Toolkit
*.uss  text diff=css eol=lf
*.uxml text eol=lf

# Unity - YAML assets (Unity SmartMerge + LF)
*.meta               merge=unityyamlmerge text eol=lf
*.unity              merge=unityyamlmerge text eol=lf
*.prefab             merge=unityyamlmerge text eol=lf
*.asset              merge=unityyamlmerge text eol=lf
*.mat                merge=unityyamlmerge text eol=lf
*.anim               merge=unityyamlmerge text eol=lf
*.controller         merge=unityyamlmerge text eol=lf
*.overrideController merge=unityyamlmerge text eol=lf
*.physicsMaterial2D  merge=unityyamlmerge text eol=lf
*.physicMaterial     merge=unityyamlmerge text eol=lf
*.spriteatlas        merge=unityyamlmerge text eol=lf

# GitHub cleanup
Assets/Plugins/**           linguist-generated
Packages/packages-lock.json linguist-generated

